# Root .env for `docker compose up`. Copy this file to `.env` in the repo
# root (same directory as docker-compose.yml) — Compose reads it
# automatically for variable substitution below. Every var has a safe
# default baked into docker-compose.yml, so `docker compose up` works with
# zero setup (offline/demo mode); fill these in only for live LLM,
# Supabase-backed workspaces, or blockchain anchoring.

# ── LLM provider (backend/llm_client.py) ─────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Blockchain anchoring (Polygon Amoy Testnet) — optional, mocks if unset ──
POLYGON_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_MAX_RETRIES=1
BLOCKCHAIN_RETRY_BACKOFF_SECONDS=2

# ── Supabase (per-user saved workspaces) — optional, falls back to local
# session storage inside the container if unset ─────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Frontend build-time vars (baked into the JS bundle by Vite, not read at
# container runtime) — same optional-Supabase fallback applies ─────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
